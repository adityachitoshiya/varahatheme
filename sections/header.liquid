{% comment %}
  Varaha Jewels — Header Section
  Mega menu navigation with mobile drawer
{% endcomment %}

{% section 'announcement-bar' %}

<header class="header" data-header>
  <div class="header__inner">
    <!-- Logo -->
    <a href="/" class="header__logo">
      <img
        src="{{ 'logo.png' | asset_url }}"
        alt="{{ shop.name }}"
        class="header__logo-img"
        width="160"
        height="50"
        loading="eager"
      >
      <span class="header__logo-tagline">Where heritage meets royalty</span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="header__nav" aria-label="Main navigation">
      <!-- Collections Mega Menu -->
      <div class="header__mega-menu">
        <button class="header__nav-link" aria-expanded="false" aria-haspopup="true">
          Collections
          <svg class="header__chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
        </button>

        <div class="header__mega-dropdown">
          <div class="header__mega-dropdown-inner">
            <div class="header__mega-grid">
              <!-- Women -->
              <div>
                <h3 class="header__mega-title">Women</h3>
                <div>
                  <p class="header__mega-label">Shop by Category</p>
                  <a href="/collections/women-necklaces" class="header__mega-link">Necklaces</a>
                  <a href="/collections/women-earrings" class="header__mega-link">Earrings</a>
                  <a href="/collections/women-rings" class="header__mega-link">Rings</a>
                  <a href="/collections/women-bangles-bracelets" class="header__mega-link">Bangles & Bracelets</a>
                  <a href="/collections/women-mangalsutra" class="header__mega-link">Mangalsutra</a>
                </div>
                <div style="margin-top: 1rem;">
                  <p class="header__mega-label">Shop by Look</p>
                  <a href="/collections/women-bridal" class="header__mega-link">Bridal</a>
                  <a href="/collections/women-minimal" class="header__mega-link">Minimal</a>
                </div>
                <a href="/collections/women" class="header__mega-viewall">View All Women's →</a>
              </div>

              <!-- Men -->
              <div>
                <h3 class="header__mega-title">Men</h3>
                <a href="/collections/men-necklaces-chains" class="header__mega-link">Necklaces & Chains</a>
                <a href="/collections/men-rings" class="header__mega-link">Rings</a>
                <a href="/collections/men-bracelets" class="header__mega-link">Bracelets</a>
                <a href="/collections/men" class="header__mega-viewall">View All Men's →</a>
              </div>
            </div>

            <div class="header__mega-footer">
              <a href="/collections/all">Browse All Collections →</a>
            </div>
          </div>
        </div>
      </div>

      <a href="/pages/ciplx" class="header__nav-link header__nav-link--ciplx">
        <span>Ciplx</span>
        <small>by varaha heaths</small>
      </a>
      <a href="/pages/heritage" class="header__nav-link">Heritage</a>
      <a href="/collections/new-arrivals" class="header__nav-link">New Arrivals</a>
      <a href="/pages/contact" class="header__nav-link">Contact</a>
    </nav>

    <!-- Right Actions -->
    <div class="header__actions">
      <!-- Search (Desktop) -->
      <button class="header__action-btn header__desktop-only" data-search-toggle aria-label="Search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
      </button>

      <!-- Wishlist (Desktop) -->
      <a href="/pages/wishlist" class="header__action-btn header__desktop-only" aria-label="Wishlist" style="position:relative;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
      </a>

      <!-- Cart -->
      <button class="header__action-btn header__cart-btn" data-cart-toggle aria-label="Shopping cart" style="position:relative;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
        {% if cart.item_count > 0 %}
          <span class="header__badge">{{ cart.item_count }}</span>
        {% endif %}
      </button>

      <!-- Account (Desktop) -->
      <div class="header__desktop-only">
        {% if customer %}
          <a href="/account" class="header__action-btn" aria-label="My Account" style="gap:0.5rem;font-size:0.875rem;font-weight:500;width:auto;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            <span>Hi {{ customer.first_name }}!</span>
          </a>
        {% else %}
          <a href="/account/login" class="header__action-btn" aria-label="Sign In">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </a>
        {% endif %}
      </div>

      <!-- Mobile Menu Toggle -->
      <button class="header__action-btn header__menu-toggle" data-mobile-menu-toggle aria-label="Menu" aria-expanded="false">
        <svg class="header__menu-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
    </div>
  </div>

  <!-- Desktop Search Bar -->
  <div class="header__search" data-search-bar style="max-width:80rem;margin:0 auto;padding:0 0.75rem;">
    <div class="header__search-input-wrap">
      <form action="/search" method="get">
        <input
          type="text"
          name="q"
          placeholder="Search for jewelry..."
          class="header__search-input"
          data-search-input
          autocomplete="off"
        >
        <svg class="header__search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
      </form>
      <button data-search-close style="position:absolute;right:1rem;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;color:rgba(122,59,35,0.6);">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Menu Backdrop -->
<div class="mobile-backdrop" data-mobile-backdrop aria-hidden="true"></div>

<!-- Mobile Menu -->
<div class="mobile-menu" data-mobile-menu>
  <div class="mobile-menu__inner">
    <nav class="mobile-menu__nav">
      <!-- Mobile Search -->
      <div class="mobile-menu__search">
        <form action="/search" method="get">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
          <input type="text" name="q" placeholder="Search for jewelry..." autocomplete="off">
        </form>
      </div>

      <!-- Auth -->
      <div class="mobile-menu__auth">
        {% if customer %}
          <div style="background:rgba(255,255,255,0.5);border-radius:0.5rem;padding:0.75rem;display:flex;align-items:center;justify-content:space-between;border:1px solid rgba(122,59,35,0.1);">
            <div style="display:flex;align-items:center;gap:0.75rem;">
              <div style="width:2rem;height:2rem;border-radius:50%;background:rgba(163,86,42,0.1);display:flex;align-items:center;justify-content:center;color:var(--copper);font-weight:700;">
                {{ customer.first_name | slice: 0 | upcase }}
              </div>
              <div>
                <p style="font-size:0.875rem;font-weight:600;color:var(--heritage);">{{ customer.first_name }} {{ customer.last_name }}</p>
                <p style="font-size:0.75rem;color:#6b7280;">{{ customer.email }}</p>
              </div>
            </div>
            <a href="/account/logout" style="color:#6b7280;" aria-label="Logout">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
            </a>
          </div>
        {% else %}
          <a href="/account/login" class="mobile-menu__login-btn">Sign In / Register</a>
        {% endif %}
      </div>

      <!-- Women Accordion -->
      <div style="margin-bottom:0.25rem;">
        <button class="mobile-menu__accordion-btn" data-accordion-toggle aria-expanded="false" aria-controls="mobile-women-menu">
          <div class="mobile-menu__link-inner">
            <span>Women</span>
            <svg class="mobile-menu__chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
          </div>
        </button>
        <div class="mobile-menu__accordion-content" id="mobile-women-menu">
          <p class="header__mega-label" style="padding:0.5rem 1rem 0.25rem;">Shop by Category</p>
          <a href="/collections/women-necklaces">Necklaces</a>
          <a href="/collections/women-earrings">Earrings</a>
          <a href="/collections/women-rings">Rings</a>
          <a href="/collections/women-bangles-bracelets">Bangles & Bracelets</a>
          <a href="/collections/women-mangalsutra">Mangalsutra</a>
          <p class="header__mega-label" style="padding:0.75rem 1rem 0.25rem;">Shop by Look</p>
          <a href="/collections/women-bridal">Bridal</a>
          <a href="/collections/women-minimal">Minimal</a>
          <a href="/collections/women" style="font-weight:600;color:var(--copper);">View All Women's →</a>
        </div>
      </div>

      <!-- Men Accordion -->
      <div style="margin-bottom:0.25rem;">
        <button class="mobile-menu__accordion-btn" data-accordion-toggle aria-expanded="false" aria-controls="mobile-men-menu">
          <div class="mobile-menu__link-inner">
            <span>Men</span>
            <svg class="mobile-menu__chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
          </div>
        </button>
        <div class="mobile-menu__accordion-content" id="mobile-men-menu">
          <a href="/collections/men-necklaces-chains">Necklaces & Chains</a>
          <a href="/collections/men-rings">Rings</a>
          <a href="/collections/men-bracelets">Bracelets</a>
          <a href="/collections/men" style="font-weight:600;color:var(--copper);">View All Men's →</a>
        </div>
      </div>

      <!-- Other Links -->
      <a href="/collections/all" class="mobile-menu__link"><div class="mobile-menu__link-inner"><span>All Collections</span><div class="mobile-menu__dot"></div></div></a>
      <a href="/pages/ciplx" class="mobile-menu__link">
        <div class="mobile-menu__link-inner">
          <div><span style="display:block;line-height:1.2;">Ciplx</span><span style="font-size:10px;color:rgba(122,59,35,0.6);">by varaha heaths</span></div>
          <div class="mobile-menu__dot"></div>
        </div>
      </a>
      <a href="/pages/heritage" class="mobile-menu__link"><div class="mobile-menu__link-inner"><span>Heritage</span><div class="mobile-menu__dot"></div></div></a>
      <a href="/collections/new-arrivals" class="mobile-menu__link"><div class="mobile-menu__link-inner"><span>New Arrivals</span><div class="mobile-menu__dot"></div></div></a>
      <a href="/pages/contact" class="mobile-menu__link"><div class="mobile-menu__link-inner"><span>Contact</span><div class="mobile-menu__dot"></div></div></a>

      <!-- Wishlist -->
      <a href="/pages/wishlist" class="mobile-menu__link mobile-menu__wishlist">
        <div class="mobile-menu__link-inner">
          <div style="display:flex;align-items:center;gap:0.75rem;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
            <span>My Wishlist</span>
          </div>
        </div>
      </a>

      <!-- Account -->
      <a href="/account" class="mobile-menu__link">
        <div class="mobile-menu__link-inner">
          <div style="display:flex;align-items:center;gap:0.75rem;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            <span>My Account</span>
          </div>
          <div class="mobile-menu__dot"></div>
        </div>
      </a>

      <div class="mobile-menu__footer">
        <p>Discover timeless elegance</p>
      </div>
    </nav>
  </div>
</div>

<!-- Header Spacer (Mobile) -->
<div class="header-spacer" aria-hidden="true"></div>

{% schema %}
{
  "name": "Header",
  "class": "header-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Logo Tagline",
      "default": "Where heritage meets royalty"
    }
  ]
}
{% endschema %}
