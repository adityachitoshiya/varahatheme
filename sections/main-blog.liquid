{% comment %} Varaha Jewels — Blog Listing {% endcomment %}

<section style="padding:3rem 0 6rem;background:var(--warm-sand);min-height:60vh;">
  <div class="container">
    <div style="text-align:center;margin-bottom:3rem;">
      <div style="width:4rem;height:1px;background:var(--copper);margin:0 auto 1.5rem;"></div>
      <h1 style="font-family:var(--font-royal);font-size:clamp(2.5rem,6vw,3.75rem);font-weight:700;color:var(--heritage);">{{ blog.title }}</h1>
    </div>

    {% if blog.articles.size > 0 %}
      <div class="blog-grid">
        {% for article in blog.articles %}
          <a href="{{ article.url }}" style="display:block;text-decoration:none;background:white;border:1px solid rgba(163,86,42,0.2);border-radius:0.5rem;overflow:hidden;transition:all 0.3s;">
            {% if article.image %}
              <img src="{{ article.image | image_url: width: 800 }}" alt="{{ article.title | escape }}" style="width:100%;height:16rem;object-fit:cover;" loading="lazy">
            {% endif %}
            <div style="padding:1.5rem;">
              <h2 style="font-family:var(--font-royal);font-size:1.5rem;color:var(--heritage);margin-bottom:0.5rem;">{{ article.title }}</h2>
              <p style="font-size:0.875rem;color:rgba(122,59,35,0.5);margin-bottom:0.75rem;">{{ article.published_at | date: '%B %d, %Y' }} • {{ article.author }}</p>
              <p style="color:rgba(122,59,35,0.7);line-height:1.6;">{{ article.excerpt_or_content | strip_html | truncatewords: 30 }}</p>
            </div>
          </a>
        {% endfor %}
      </div>
    {% else %}
      <p style="text-align:center;color:rgba(122,59,35,0.5);">No articles yet.</p>
    {% endif %}
  </div>
</section>

<style>
  .blog-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  @media (min-width: 768px) {
    .blog-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .blog-grid { grid-template-columns: repeat(3, 1fr); }
  }
</style>

{% schema %}
{ "name": "Blog Page", "settings": [] }
{% endschema %}
