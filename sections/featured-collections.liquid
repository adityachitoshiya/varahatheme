{% comment %}
  Varaha Jewels — Featured Collections
  4-column collection grid with scroll animations
{% endcomment %}

{{ 'section-featured-collections.css' | asset_url | stylesheet_tag }}

<section class="featured-collections">
  <div class="container">
    <!-- Section Header -->
    <div class="featured-collections__header scroll-animate">
      <div class="featured-collections__line"></div>
      <h2 class="featured-collections__title">{{ section.settings.heading }}</h2>
      <p class="featured-collections__subtitle">{{ section.settings.subheading }}</p>
    </div>

    <!-- Collection Grid -->
    <div class="featured-collections__grid">
      {% for block in section.blocks %}
        <a
          href="{{ block.settings.collection.url | default: '/collections/all' }}"
          class="collection-card scroll-animate"
          style="transition-delay: {{ forloop.index0 | times: 150 }}ms;"
          {{ block.shopify_attributes }}
        >
          <div class="collection-card__image-wrap">
            {% if block.settings.image %}
              <img
                src="{{ block.settings.image | image_url: width: 600 }}"
                alt="{{ block.settings.title | escape }}"
                class="collection-card__image"
                loading="lazy"
                width="600"
                height="480"
              >
            {% elsif block.settings.collection.featured_image %}
              <img
                src="{{ block.settings.collection.featured_image | image_url: width: 600 }}"
                alt="{{ block.settings.title | escape }}"
                class="collection-card__image"
                loading="lazy"
                width="600"
                height="480"
              >
            {% else %}
              {{ 'collection-' | append: forloop.index | placeholder_svg_tag: 'collection-card__image' }}
            {% endif %}
            <div class="collection-card__overlay"></div>
          </div>

          <div class="collection-card__body">
            <h3 class="collection-card__name">{{ block.settings.title }}</h3>
            <p class="collection-card__desc">{{ block.settings.description }}</p>
            <div class="collection-card__cta">
              <span>Explore</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
            </div>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Collections",
  "class": "featured-collections-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Collections"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Discover exquisite pieces that blend heritage with contemporary elegance"
    }
  ],
  "max_blocks": 8,
  "blocks": [
    {
      "type": "collection_card",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Heritage Collection"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Timeless pieces inspired by royal traditions"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Image (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Collections",
      "blocks": [
        { "type": "collection_card", "settings": { "title": "Heritage Collection", "description": "Timeless pieces inspired by royal traditions" } },
        { "type": "collection_card", "settings": { "title": "Bridal Elegance", "description": "Exquisite adornments for your special day" } },
        { "type": "collection_card", "settings": { "title": "Contemporary Classics", "description": "Modern designs with traditional soul" } },
        { "type": "collection_card", "settings": { "title": "Temple Treasures", "description": "Sacred artistry in every detail" } }
      ]
    }
  ]
}
{% endschema %}
