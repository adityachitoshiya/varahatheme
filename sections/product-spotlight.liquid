{% comment %}
  Varaha Jewels — Product Spotlight
  Featured product with floating glass card and thumbnails
{% endcomment %}

{{ 'section-product-spotlight.css' | asset_url | stylesheet_tag }}

{% assign featured = section.settings.product %}

<section class="product-spotlight" data-product-spotlight>
  <!-- BG Decor -->
  <div class="product-spotlight__bg">
    <div class="product-spotlight__bg-circle product-spotlight__bg-circle--copper"></div>
    <div class="product-spotlight__bg-circle product-spotlight__bg-circle--heritage"></div>
  </div>

  <div class="container" style="position:relative;z-index:10;">
    <!-- Header -->
    <div class="product-spotlight__header scroll-animate">
      <span class="product-spotlight__badge">{{ section.settings.badge_text }}</span>
      <h2 class="product-spotlight__title">{{ section.settings.heading }}</h2>
    </div>

    <!-- Layout -->
    <div class="product-spotlight__layout scroll-animate" style="transition-delay:200ms;">
      <!-- Image Area -->
      <div class="product-spotlight__image-wrap">
        <div class="product-spotlight__image-container">
          {% if featured and featured.featured_image %}
            <img
              src="{{ featured.featured_image | image_url: width: 1000 }}"
              alt="{{ featured.title | escape }}"
              class="product-spotlight__image"
              data-spotlight-image
              loading="lazy"
              width="1000"
              height="800"
            >
          {% elsif section.blocks.size > 0 and section.blocks[0].settings.image %}
            <img
              src="{{ section.blocks[0].settings.image | image_url: width: 1000 }}"
              alt="{{ section.blocks[0].settings.title | escape }}"
              class="product-spotlight__image"
              data-spotlight-image
              loading="lazy"
              width="1000"
              height="800"
            >
          {% else %}
            {{ 'product-1' | placeholder_svg_tag: 'product-spotlight__image' }}
          {% endif %}
          <div class="product-spotlight__image-overlay"></div>

          <!-- Tags -->
          <div class="product-spotlight__tags">
            {% if featured and featured.tags contains 'premium' %}
              <span class="product-spotlight__tag product-spotlight__tag--premium">Premium</span>
            {% endif %}
            {% if featured %}
              <span class="product-spotlight__tag product-spotlight__tag--label" data-spotlight-tag>{{ featured.type | default: 'Featured' }}</span>
            {% elsif section.blocks.size > 0 %}
              <span class="product-spotlight__tag product-spotlight__tag--label" data-spotlight-tag>{{ section.blocks[0].settings.tag | default: 'Featured' }}</span>
            {% endif %}
          </div>
        </div>
      </div>

      <!-- Info Card -->
      <div class="product-spotlight__info">
        <div class="product-spotlight__card">
          <div class="product-spotlight__stars">
            {% for i in (1..5) %}
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            {% endfor %}
            <span class="product-spotlight__stars-label">(Bestseller)</span>
          </div>

          <h3 class="product-spotlight__name" data-spotlight-name>
            {% if featured %}
              {{ featured.title }}
            {% elsif section.blocks.size > 0 %}
              {{ section.blocks[0].settings.title | default: 'Heritage Masterpiece' }}
            {% else %}
              Heritage Masterpiece
            {% endif %}
          </h3>

          <p class="product-spotlight__desc line-clamp-3" data-spotlight-desc>
            {% if featured %}
              {{ featured.description | strip_html | truncatewords: 30 }}
            {% elsif section.blocks.size > 0 %}
              {{ section.blocks[0].settings.description | default: 'Experience the timeless elegance of our handcrafted masterpiece, designed to illuminate your grace.' }}
            {% else %}
              Experience the timeless elegance of our handcrafted masterpiece, designed to illuminate your grace.
            {% endif %}
          </p>

          <div class="product-spotlight__price" data-spotlight-price>
            {% if featured %}
              {{ featured.price | money }}
            {% elsif section.blocks.size > 0 %}
              {{ section.blocks[0].settings.price | default: 'Price on Request' }}
            {% else %}
              Price on Request
            {% endif %}
          </div>

          <div class="product-spotlight__actions">
            <a
              href="{% if featured %}{{ featured.url }}{% elsif section.blocks.size > 0 %}{{ section.blocks[0].settings.link | default: '/collections/all' }}{% else %}/collections/all{% endif %}"
              class="product-spotlight__btn-shop"
              data-spotlight-link
            >
              Shop Now
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
            </a>
            <a
              href="{% if featured %}{{ featured.url }}{% else %}/collections/all{% endif %}"
              class="product-spotlight__btn-bag"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
            </a>
          </div>
        </div>

        <!-- Thumbnails -->
        {% if section.blocks.size > 1 %}
          <div class="product-spotlight__thumbs">
            {% for block in section.blocks %}
              <button
                class="product-spotlight__thumb{% if forloop.first %} active{% endif %}"
                data-spotlight-thumb
                data-image="{{ block.settings.image | image_url: width: 1000 }}"
                data-name="{{ block.settings.title | escape }}"
                data-desc="{{ block.settings.description | escape }}"
                data-price="{{ block.settings.price | escape }}"
                data-url="{{ block.settings.link | default: '/collections/all' }}"
                data-tag="{{ block.settings.tag | default: 'Featured' }}"
                {{ block.shopify_attributes }}
              >
                {% if block.settings.image %}
                  <img src="{{ block.settings.image | image_url: width: 160 }}" alt="{{ block.settings.title | escape }}" loading="lazy" width="80" height="80">
                {% else %}
                  {{ 'product-' | append: forloop.index | placeholder_svg_tag }}
                {% endif %}
              </button>
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product Spotlight",
  "class": "product-spotlight-section",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "Exquisite Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Masterpieces"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Featured Product (optional)"
    }
  ],
  "max_blocks": 8,
  "blocks": [
    {
      "type": "product_item",
      "name": "Spotlight Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Product Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Product Name",
          "default": "Heritage Necklace"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Experience the timeless elegance of our handcrafted masterpiece."
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "₹24,999"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Tag",
          "default": "Featured"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Product Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Spotlight",
      "blocks": [
        { "type": "product_item", "settings": { "title": "Heritage Kundan Necklace", "price": "₹24,999", "tag": "Bestseller" } },
        { "type": "product_item", "settings": { "title": "Royal Temple Set", "price": "₹32,999", "tag": "Premium" } }
      ]
    }
  ]
}
{% endschema %}
