{% comment %} Varaha Jewels — Article Page {% endcomment %}

<article style="padding:3rem 0 6rem;background:var(--warm-sand);min-height:60vh;">
  <div class="container" style="max-width:48rem;">
    <div style="text-align:center;margin-bottom:3rem;">
      <p style="font-size:0.875rem;color:var(--copper);margin-bottom:1rem;">{{ article.published_at | date: '%B %d, %Y' }} • {{ article.author }}</p>
      <h1 style="font-family:var(--font-royal);font-size:clamp(2rem,5vw,3rem);font-weight:700;color:var(--heritage);margin-bottom:1.5rem;">{{ article.title }}</h1>
    </div>

    {% if article.image %}
      <img src="{{ article.image | image_url: width: 1200 }}" alt="{{ article.title | escape }}" style="width:100%;border-radius:0.75rem;margin-bottom:2.5rem;" loading="eager">
    {% endif %}

    <div style="font-family:var(--font-sans);font-size:1.0625rem;color:rgba(122,59,35,0.85);line-height:1.9;">
      {{ article.content }}
    </div>

    <div style="margin-top:3rem;padding-top:2rem;border-top:1px solid rgba(163,86,42,0.15);text-align:center;">
      <a href="{{ blog.url }}" style="color:var(--copper);font-weight:500;text-decoration:none;">← Back to {{ blog.title }}</a>
    </div>
  </div>
</article>

{% schema %}
{ "name": "Article Page", "settings": [] }
{% endschema %}
