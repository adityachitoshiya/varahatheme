{% comment %}
  Varaha Jewels — Generic Page
{% endcomment %}

<section style="padding:3rem 0 6rem;background:var(--warm-sand);min-height:60vh;">
  <div class="container" style="max-width:48rem;">
    <div style="text-align:center;margin-bottom:3rem;">
      <div style="width:4rem;height:1px;background:var(--copper);margin:0 auto 1.5rem;"></div>
      <h1 style="font-family:var(--font-royal);font-size:clamp(2.5rem,6vw,3.75rem);font-weight:700;color:var(--heritage);">{{ page.title }}</h1>
    </div>

    <div style="font-family:var(--font-sans);font-size:1rem;color:rgba(122,59,35,0.85);line-height:1.8;">
      {{ page.content }}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Page Content",
  "settings": []
}
{% endschema %}
