{% comment %}
  Varaha Jewels — Footer
  Metal rates, trust badges, newsletter, links, social, payments
{% endcomment %}

<footer class="footer">
  <div class="footer__top-line"></div>

  <div class="container" style="position:relative;padding-top:4rem;padding-bottom:2.5rem;">

    <!-- Metal Rates -->
    {% if settings.show_metal_rates %}
      <div class="footer__rates">
        <div class="footer__rates-title">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--copper)" stroke-width="2"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
          <h5 class="footer__rates-label">Today's Live Rates (India)</h5>
        </div>
        <div class="footer__rates-grid">
          <div class="footer__rate-card footer__rate-card--gold">
            <div class="footer__rate-card-inner">
              <div>
                <p class="footer__rate-label">Gold (24K)</p>
                <p class="footer__rate-price footer__rate-price--gold" data-gold-rate data-base="{{ settings.gold_rate }}">₹{{ settings.gold_rate | replace: '.0', '' }}</p>
                <p class="footer__rate-unit">per 10 grams</p>
              </div>
              <div style="text-align:right;">
                <span class="rate-change rate-up" data-gold-change>+0.5%</span>
                <p style="font-size:0.75rem;color:rgba(244,230,216,0.4);margin-top:0.25rem;">Today</p>
              </div>
            </div>
          </div>
          <div class="footer__rate-card footer__rate-card--silver">
            <div class="footer__rate-card-inner">
              <div>
                <p class="footer__rate-label">Silver (999)</p>
                <p class="footer__rate-price footer__rate-price--silver" data-silver-rate data-base="{{ settings.silver_rate }}">₹{{ settings.silver_rate | replace: '.0', '' }}</p>
                <p class="footer__rate-unit">per 1 kg</p>
              </div>
              <div style="text-align:right;">
                <span class="rate-change rate-up" data-silver-change>+0.3%</span>
                <p style="font-size:0.75rem;color:rgba(244,230,216,0.4);margin-top:0.25rem;">Today</p>
              </div>
            </div>
          </div>
        </div>
        <p class="footer__rates-note">
          <span class="footer__rates-dot"></span>
          Simulated rates • Updates every 30 seconds
        </p>
      </div>
    {% endif %}

    <!-- Trust Badges -->
    <div class="footer__trust animate-fadeIn">
      {% assign badges = "Free Shipping|On orders above ₹5000,7 Day Returns|Easy return policy,Lifetime Warranty|Certified jewellery,100% Authentic|Guaranteed purity" | split: ',' %}
      {% assign icons = "bag,heart,crown,sparkles" | split: ',' %}
      {% for badge in badges %}
        {% assign parts = badge | split: '|' %}
        <div class="footer__trust-item">
          <div style="display:flex;flex-direction:column;align-items:center;gap:0.5rem;">
            <div class="footer__trust-icon">
              {% assign icon = icons[forloop.index0] %}
              {% if icon == 'bag' %}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
              {% elsif icon == 'heart' %}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
              {% elsif icon == 'crown' %}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 4l3 12h14l3-12-5 4-5-4-5 4-5-4z"/><path d="M3 20h18"/></svg>
              {% else %}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              {% endif %}
            </div>
            <div>
              <p class="footer__trust-title">{{ parts[0] }}</p>
              <p class="footer__trust-desc">{{ parts[1] }}</p>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>

    <!-- Main Grid -->
    <div class="footer__grid">
      <!-- Brand & Newsletter -->
      <div style="display:flex;flex-direction:column;gap:1.5rem;">
        <div class="footer__brand">
          <img src="{{ 'logo.png' | asset_url }}" alt="{{ shop.name }}" class="footer__brand-logo" width="200" height="70" loading="lazy">
          <div class="footer__brand-underline" style="margin-top:-0.5rem;"></div>
          <p class="footer__brand-tagline">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--copper)" stroke-width="2"><path d="M2 4l3 12h14l3-12-5 4-5-4-5 4-5-4z"/></svg>
            Where heritage meets royalty
          </p>
        </div>

        <div style="display:flex;flex-direction:column;gap:1rem;">
          <h3 class="footer__newsletter-title">Join Our Royal Family</h3>
          <p class="footer__newsletter-desc">Get exclusive access to new collections, special offers, and royal treatment.</p>

          <form method="post" action="/contact#contact_form" accept-charset="UTF-8" style="display:flex;flex-direction:column;gap:0.75rem;">
            <input type="hidden" name="form_type" value="customer">
            <input type="hidden" name="utf8" value="✓">
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div style="position:relative;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="footer__newsletter-icon"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              <input type="email" name="contact[email]" placeholder="Enter your email address" class="footer__newsletter-input" required>
            </div>
            <button type="submit" class="footer__newsletter-btn">
              Subscribe Now
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            </button>
          </form>

          <!-- Contact -->
          <div class="footer__contact" style="padding-top:1rem;border-top:1px solid rgba(163,86,42,0.2);">
            <a href="tel:{{ settings.contact_phone | remove: ' ' }}">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              {{ settings.contact_phone }}
            </a>
            <a href="mailto:{{ settings.contact_email }}">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              {{ settings.contact_email }}
            </a>
            <div>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-top:2px;"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
              {{ settings.contact_address }}
            </div>
          </div>
        </div>
      </div>

      <!-- Quick Links -->
      <div class="footer__links">
        <div>
          <h4 class="footer__links-title">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
            Collections
          </h4>
          <ul class="footer__links-list">
            {% assign collections_list = "Heritage,Bridal,Exclusive,New Arrivals,Best Sellers" | split: ',' %}
            {% for item in collections_list %}
              <li><a href="/collections/all"><span class="arrow">→</span>{{ item }}</a></li>
            {% endfor %}
          </ul>
        </div>

        <div>
          <h4 class="footer__links-title">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
            Support
          </h4>
          <ul class="footer__links-list">
            <li><a href="/pages/contact"><span class="arrow">→</span>Contact Us</a></li>
            <li><a href="/account"><span class="arrow">→</span>Track Order</a></li>
            <li><a href="/pages/faq"><span class="arrow">→</span>FAQs</a></li>
            <li><a href="/policies/shipping-policy"><span class="arrow">→</span>Shipping Info</a></li>
            <li><a href="/pages/size-guide"><span class="arrow">→</span>Size Guide</a></li>
          </ul>
        </div>

        <div>
          <h4 class="footer__links-title">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 4l3 12h14l3-12-5 4-5-4-5 4-5-4z"/><path d="M3 20h18"/></svg>
            Company
          </h4>
          <ul class="footer__links-list">
            <li><a href="/pages/about"><span class="arrow">→</span>About Us</a></li>
            <li><a href="/pages/story"><span class="arrow">→</span>Our Story</a></li>
            <li><a href="/policies/privacy-policy"><span class="arrow">→</span>Privacy Policy</a></li>
            <li><a href="/policies/terms-of-service"><span class="arrow">→</span>Terms</a></li>
            <li><a href="/policies/refund-policy"><span class="arrow">→</span>Refund Policy</a></li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="footer__bottom">
      <div class="footer__bottom-inner">
        <!-- Social -->
        <div class="footer__social">
          <span class="footer__social-label">Follow Us:</span>
          <div style="display:flex;gap:0.75rem;">
            <a href="{{ settings.social_instagram }}" class="footer__social-link footer__social-link--ig" aria-label="Instagram" target="_blank" rel="noopener">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
            </a>
            <a href="{{ settings.social_facebook }}" class="footer__social-link footer__social-link--fb" aria-label="Facebook" target="_blank" rel="noopener">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
            </a>
            <a href="{{ settings.social_twitter }}" class="footer__social-link footer__social-link--tw" aria-label="Twitter" target="_blank" rel="noopener">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"/></svg>
            </a>
          </div>
        </div>

        <!-- Payments -->
        <div class="footer__payments">
          <span class="footer__payments-label">Secure Payments:</span>
          <div style="display:flex;gap:0.5rem;">
            <div class="footer__payment-icon"><img src="{{ 'visa_icon.svg' | asset_url }}" alt="Visa" width="35" height="22" loading="lazy"></div>
            <div class="footer__payment-icon"><img src="{{ 'mastercard_icon.svg' | asset_url }}" alt="Mastercard" width="35" height="22" loading="lazy"></div>
            <div class="footer__payment-icon"><img src="{{ 'rupay_icon.svg' | asset_url }}" alt="RuPay" width="35" height="22" loading="lazy"></div>
          </div>
        </div>
      </div>

      <!-- Copyright -->
      <div class="footer__copyright">
        <p>
          <span>© {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</span>
          <span style="display:none;" class="footer__sep">•</span>
          <span style="display:flex;align-items:center;gap:0.25rem;">
            Made with <svg class="footer__heart" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg> in India
          </span>
        </p>
      </div>
    </div>
  </div>

  <div class="footer__glow"></div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "footer-section",
  "settings": []
}
{% endschema %}
