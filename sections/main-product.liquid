{% comment %}
  Varaha Jewels — Product Detail Page
  Premium product page with image gallery, info, and add to cart
{% endcomment %}

<section style="padding:2rem 0 6rem;background:var(--warm-sand);min-height:80vh;">
  <div class="container">
    <!-- Breadcrumb -->
    <nav style="margin-bottom:2rem;font-size:0.875rem;color:rgba(122,59,35,0.6);" aria-label="Breadcrumb">
      <a href="/" style="color:var(--copper);text-decoration:none;">Home</a>
      <span style="margin:0 0.5rem;">/</span>
      {% if product.collections.size > 0 %}
        <a href="{{ product.collections.first.url }}" style="color:var(--copper);text-decoration:none;">{{ product.collections.first.title }}</a>
        <span style="margin:0 0.5rem;">/</span>
      {% endif %}
      <span>{{ product.title }}</span>
    </nav>

    <div class="product-page-grid">
      <!-- Image Gallery -->
      <div>
        <div style="aspect-ratio:1;border-radius:0.75rem;overflow:hidden;background:white;border:1px solid rgba(163,86,42,0.2);margin-bottom:1rem;">
          {% if product.featured_image %}
            <img
              src="{{ product.featured_image | image_url: width: 1000 }}"
              alt="{{ product.title | escape }}"
              style="width:100%;height:100%;object-fit:cover;"
              id="main-product-image"
              loading="eager"
            >
          {% else %}
            {{ 'product-1' | placeholder_svg_tag }}
          {% endif %}
        </div>

        <!-- Thumbnails -->
        {% if product.images.size > 1 %}
          <div style="display:flex;gap:0.75rem;overflow-x:auto;padding-bottom:0.5rem;" class="scrollbar-hide">
            {% for image in product.images %}
              <button
                onclick="document.getElementById('main-product-image').src='{{ image | image_url: width: 1000 }}'"
                style="flex-shrink:0;width:5rem;height:5rem;border-radius:0.5rem;overflow:hidden;border:2px solid {% if forloop.first %}var(--copper){% else %}transparent{% endif %};cursor:pointer;transition:all 0.3s;opacity:{% if forloop.first %}1{% else %}0.6{% endif %};background:none;padding:0;"
              >
                <img src="{{ image | image_url: width: 160 }}" alt="{{ product.title | escape }}" style="width:100%;height:100%;object-fit:cover;" loading="lazy">
              </button>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <!-- Product Info -->
      <div>
        <!-- Tags -->
        {% if product.tags.size > 0 %}
          <div style="display:flex;gap:0.5rem;margin-bottom:1rem;flex-wrap:wrap;">
            {% for tag in product.tags limit:3 %}
              <span style="padding:0.25rem 0.75rem;font-size:0.75rem;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;background:rgba(163,86,42,0.1);color:var(--copper);border-radius:2px;">{{ tag }}</span>
            {% endfor %}
          </div>
        {% endif %}

        <h1 style="font-family:var(--font-royal);font-size:clamp(2rem,5vw,3rem);font-weight:700;color:var(--heritage);margin-bottom:1rem;line-height:1.15;">
          {{ product.title }}
        </h1>

        <!-- Stars -->
        <div style="display:flex;align-items:center;gap:0.25rem;margin-bottom:1.5rem;">
          {% for i in (1..5) %}
            <svg width="18" height="18" viewBox="0 0 24 24" fill="var(--copper)" stroke="var(--copper)" stroke-width="1"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          {% endfor %}
          <span style="font-size:0.875rem;color:rgba(122,59,35,0.5);margin-left:0.5rem;">(4.9 Rating)</span>
        </div>

        <!-- Price -->
        <div style="display:flex;align-items:baseline;gap:1rem;margin-bottom:2rem;">
          <span style="font-size:2rem;font-weight:300;color:var(--copper);">{{ product.price | money }}</span>
          {% if product.compare_at_price > product.price %}
            <span style="font-size:1.25rem;color:rgba(122,59,35,0.4);text-decoration:line-through;">{{ product.compare_at_price | money }}</span>
            {% assign savings = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price %}
            <span style="font-size:0.875rem;font-weight:600;color:#16a34a;background:rgba(22,163,74,0.1);padding:0.25rem 0.5rem;border-radius:4px;">Save {{ savings }}%</span>
          {% endif %}
        </div>

        <!-- Description -->
        {% if product.description != blank %}
          <div style="font-family:var(--font-playfair);font-size:1rem;color:rgba(122,59,35,0.8);line-height:1.7;margin-bottom:2rem;" class="line-clamp-3">
            {{ product.description }}
          </div>
        {% endif %}

        <!-- Variant Selector -->
        {% if product.has_only_default_variant == false %}
          <form method="post" action="/cart/add" id="product-form">
            {% for option in product.options_with_values %}
              <div style="margin-bottom:1.5rem;">
                <label style="display:block;font-weight:600;color:var(--heritage);margin-bottom:0.5rem;font-size:0.875rem;">{{ option.name }}</label>
                <div style="display:flex;gap:0.5rem;flex-wrap:wrap;">
                  {% for value in option.values %}
                    <label style="padding:0.5rem 1rem;border:1px solid rgba(163,86,42,0.3);border-radius:2px;cursor:pointer;font-size:0.875rem;transition:all 0.2s;color:var(--heritage);">
                      <input type="radio" name="options[{{ option.name }}]" value="{{ value }}" {% if forloop.first %}checked{% endif %} style="display:none;">
                      {{ value }}
                    </label>
                  {% endfor %}
                </div>
              </div>
            {% endfor %}

            <select name="id" style="display:none;">
              {% for variant in product.variants %}
                <option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %}>
                  {{ variant.title }} - {{ variant.price | money }}
                </option>
              {% endfor %}
            </select>

            <!-- Add to Cart -->
            <button
              type="submit"
              class="btn btn-primary"
              style="width:100%;padding:1.125rem;font-size:1rem;font-weight:600;border-radius:0.5rem;margin-bottom:1rem;box-shadow:0 10px 20px rgba(163,86,42,0.2);"
              {% unless product.available %}disabled{% endunless %}
            >
              {% if product.available %}
                Add to Cart
              {% else %}
                Sold Out
              {% endif %}
            </button>
          </form>
        {% else %}
          <form method="post" action="/cart/add">
            <input type="hidden" name="id" value="{{ product.variants.first.id }}">
            <button
              type="submit"
              class="btn btn-primary"
              style="width:100%;padding:1.125rem;font-size:1rem;font-weight:600;border-radius:0.5rem;margin-bottom:1rem;box-shadow:0 10px 20px rgba(163,86,42,0.2);"
              {% unless product.available %}disabled{% endunless %}
            >
              {% if product.available %}Add to Cart{% else %}Sold Out{% endif %}
            </button>
          </form>
        {% endif %}

        <!-- Trust Badges -->
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:0.75rem;margin-top:1.5rem;padding-top:1.5rem;border-top:1px solid rgba(163,86,42,0.15);">
          <div style="text-align:center;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--copper)" stroke-width="2" style="margin:0 auto 0.25rem;display:block;"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            <p style="font-size:0.6875rem;color:rgba(122,59,35,0.7);">Certified</p>
          </div>
          <div style="text-align:center;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--copper)" stroke-width="2" style="margin:0 auto 0.25rem;display:block;"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            <p style="font-size:0.6875rem;color:rgba(122,59,35,0.7);">Free Shipping</p>
          </div>
          <div style="text-align:center;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--copper)" stroke-width="2" style="margin:0 auto 0.25rem;display:block;"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
            <p style="font-size:0.6875rem;color:rgba(122,59,35,0.7);">Easy Returns</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .product-page-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }
  @media (min-width: 1024px) {
    .product-page-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>

{% schema %}
{
  "name": "Product Page",
  "settings": []
}
{% endschema %}
